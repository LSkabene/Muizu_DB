properties:
  note.guberņa:
    displayName: guberna
views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("Muižu datubāze")
        - "!nosaukums_lv.isEmpty()"
    groupBy:
      property: veids
      direction: ASC
    order:
      - file.name
      - nosaukums_lv
      - nosaukums_ger
      - nosaukums_rus
      - aliases
      - veids
      - guberna
      - aprinkis_imperija
      - draudzes_novads
      - aprinkis_LV
      - pagasts
      - parent_manor
      - half_manors
      - coordinates
    sort:
      - property: aliases
        direction: ASC
      - property: veids
        direction: ASC
      - property: half_manors
        direction: ASC
      - property: coordinates
        direction: DESC
      - property: guberņa
        direction: ASC
      - property: tags
        direction: ASC
      - property: nosaukums_est
        direction: ASC
    columnSize:
      file.name: 125
      note.veids: 104
      note.aliases: 174
      note.aprinkis_imperija: 135
      note.draudzes_novads: 145
      note.half_manors: 136
    rowHeight: tall
